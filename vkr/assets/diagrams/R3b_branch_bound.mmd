flowchart TB
 A(["Б. Ветви и границы<br/>непустая поддерживаемая задача;<br/>тот же вход и функция F"]) --> P{{"Структурная<br/>невыполнимость?"}}
 P -->|"Да"| INF(["Невыполнимость доказана"])
 P -->|"Нет"| B["Получить жадный план, если возможно;<br/>задать лучший план или его отсутствие.<br/>Начать с корня дерева"]
 B --> N{{"Есть следующее состояние<br/>для входа в глубинном обходе?"}}
 N -->|"Нет"| END{{"Лучший полный план есть?"}}
 END -->|"Да"| OPT(["Оптимум доказан"])
 END -->|"Нет"| INF
 N -->|"Да"| LIM{{"Лимит узлов или времени<br/>мешает войти в состояние?"}}
 LIM -->|"Да"| STOP{{"Полный план найден?"}}
 STOP -->|"Да"| FEAS(["Допустимый план<br/>Оптимальность не доказана"])
 STOP -->|"Нет"| UNK(["Неопределённый исход<br/>Невыполнимость не доказана"])
 LIM -->|"Нет"| VIS["Учесть посещённое состояние"]
 VIS --> LEAF{{"Полный вектор?"}}
 LEAF -->|"Да"| UP["Пересчитать метрики полного плана;<br/>выбрать лучший по F, затем<br/>по вектору ID лексикографически"]
 LEAF -->|"Нет"| LB["Вычислить нижнюю оценку B: (2.14)"]
 LB --> CUT{{"Нет допустимого продолжения<br/>или B строго больше лучшей F?"}}
 CUT -->|"Да"| RET["Возврат к родителю, если он есть:<br/>снять назначение, восстановить часы;<br/>искать кандидата также у предков"]
 UP --> RET
 CUT -->|"Нет"| CH["Кандидаты: квалификация и мощность.<br/>Перебор по приращению F, затем ID;<br/>закрепить следующего и спуститься"]
 CH --> N
 RET --> N
