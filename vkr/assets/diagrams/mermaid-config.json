{
  "theme": "base",
  "securityLevel": "strict",
  "fontFamily": "DejaVu Sans, sans-serif",
  "themeVariables": {
    "background": "#ffffff",
    "primaryColor": "#ffffff",
    "primaryTextColor": "#000000",
    "primaryBorderColor": "#000000",
    "secondaryColor": "#f5f5f5",
    "secondaryTextColor": "#000000",
    "secondaryBorderColor": "#000000",
    "tertiaryColor": "#ffffff",
    "tertiaryTextColor": "#000000",
    "tertiaryBorderColor": "#000000",
    "lineColor": "#000000",
    "textColor": "#000000",
    "mainBkg": "#ffffff",
    "nodeBorder": "#000000",
    "clusterBkg": "#f5f5f5",
    "clusterBorder": "#000000",
    "edgeLabelBackground": "#ffffff",
    "actorBkg": "#ffffff",
    "actorBorder": "#000000",
    "actorTextColor": "#000000",
    "actorLineColor": "#000000",
    "signalColor": "#000000",
    "signalTextColor": "#000000",
    "labelBoxBkgColor": "#ffffff",
    "labelBoxBorderColor": "#000000",
    "labelTextColor": "#000000",
    "loopTextColor": "#000000",
    "noteBkgColor": "#f5f5f5",
    "noteBorderColor": "#000000",
    "noteTextColor": "#000000",
    "fontSize": "20px"
  },
  "flowchart": {
    "htmlLabels": false,
    "curve": "linear",
    "nodeSpacing": 22,
    "rankSpacing": 24,
    "padding": 10,
    "useMaxWidth": false,
    "wrappingWidth": 360
  },
  "er": {
    "fontSize": 20,
    "useMaxWidth": false,
    "layoutDirection": "TB",
    "minEntityWidth": 100,
    "entityPadding": 10
  },
  "sequence": {
    "useMaxWidth": false,
    "mirrorActors": false,
    "actorMargin": 35,
    "messageMargin": 24,
    "noteMargin": 10,
    "boxMargin": 8,
    "diagramMarginX": 12,
    "diagramMarginY": 12,
    "actorFontSize": 18,
    "noteFontSize": 16,
    "messageFontSize": 18
  }
}
